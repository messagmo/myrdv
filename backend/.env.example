# Copier ce fichier en .env et remplir les valeurs. Ne jamais publier .env.
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myrdv
DB_USER=postgres
DB_PASSWORD=
JWT_SECRET=changer_cette_valeur_par_une_longue_phrase_secrete
JWT_EXPIRES_IN=8h

# SMS : "simulation" (le message s'affiche dans le terminal) ou "sandbox" (Africa's Talking, Rôle 4)
SMS_MODE=simulation
NOM_ETABLISSEMENT=l'établissement
# Rôle 4 : renseigner dans le fichier .env uniquement, jamais ici ni dans Git
AT_USERNAME=sandbox
AT_API_KEY=
